[Unit]
Description=Remove expired VAPI Call Insights PII and artifacts
Requires=vapi-call-insights-backup.service
After=vapi-call-insights-backup.service

[Service]
Type=oneshot
User=vapi-call-insights
Group=vapi-call-insights
WorkingDirectory=/opt/vapi-call-insights/current
Environment=SQLITE_PATH=/var/lib/vapi-call-insights/runtime.sqlite
Environment=ARTIFACT_DIRECTORY=/var/lib/vapi-call-insights/artifacts
ExecStart=/usr/bin/npm run runtime:retain
UMask=0007
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectProc=invisible
ProcSubset=pid
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/vapi-call-insights
