# Local LiveKit --dev defaults only. Never reuse these values outside local development.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
PLATFORM_API_URL=http://localhost:8000
ALLOW_EMPTY_DISPATCH_METADATA_LOCAL_DEV=false
# Required for inbound SIP. Must match Control Plane PHONE_LOOKUP_TOKEN.
# Never put this value in VITE_* or commit it.
# PHONE_LOOKUP_TOKEN=replace-with-runtime-lookup-token

# Optional. Must match LiveKit Dispatch Rule roomConfig.agents[].agentName.
# LIVEKIT_AGENT_NAME=yino-customer-service

# Mid-call tools POST to Control Plane /api/v1/tool-invocations using PLATFORM_API_URL
# and the Demo X-Tenant-ID header. Leave unset tools as best-effort (never fail the call).



# Qwen Audio Realtime is the default customer-demo voice loop.
VOICE_PROVIDER_MODE=qwen-realtime
# Replace both placeholders below in .env.local with valid DashScope values.
DASHSCOPE_API_KEY=replace-with-your-dashscope-api-key
QWEN_REALTIME_URL=wss://your-workspace-id.cn-beijing.maas.aliyuncs.com/api-ws/v1/realtime
QWEN_REALTIME_MODEL=qwen-audio-3.0-realtime-plus
QWEN_REALTIME_VOICE=longanqian

AGENT_LANGUAGE=zh
AGENT_GREETING=您好，这里是演示机构客服，请问有什么可以帮您？

# Optional pipeline fallback (Fun-ASR + LLM + TTS): uncomment and configure.
# VOICE_PROVIDER_MODE=pipeline
# DASHSCOPE_WEBSOCKET_URL=wss://your-workspace-id.cn-beijing.maas.aliyuncs.com/api-ws/v1/inference
# FUN_ASR_MODEL=fun-asr-realtime
# OPENAI_API_KEY=replace-with-your-openai-api-key
# LLM_MODEL=gpt-4o-mini
# TTS_MODEL=gpt-4o-mini-tts
# TTS_VOICE=ash
