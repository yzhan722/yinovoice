# Local LiveKit --dev defaults only. Never reuse these values outside local development.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_URL=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_AGENT_NAME=yino-customer-service
CALL_RECORDING_DIR=data/recordings
CALL_RECORDING_MAX_BYTES=104857600
# Local Docker Compose Postgres (see ../docker-compose.yml). Leave unset to use in-memory repos.
# DATABASE_URL=postgresql+asyncpg://yino:yino@127.0.0.1:5432/yino_platform

# Optional SIP recording Fake (all four required; otherwise egress stays off).
# RECORDING_S3_ENDPOINT=https://s3.example.test
# RECORDING_S3_BUCKET=yino-recordings
# RECORDING_S3_ACCESS_KEY=replace-with-access-key
# RECORDING_S3_SECRET_KEY=replace-with-secret-key

# Optional SMTP (both host and from required; otherwise notify is a no-op).
# Port 587 uses STARTTLS; port 465 uses SSL. Never log the password.
# SMTP_HOST=smtp.example.test
# SMTP_PORT=587
# SMTP_USERNAME=replace-with-smtp-user
# SMTP_PASSWORD=replace-with-smtp-password
# SMTP_FROM=noreply@example.test

# Optional Call Insights ingest (both required to drain the queue). Never log the token.
# INSIGHTS_BASE_URL=https://calls.yino.au
# INSIGHTS_INGEST_TOKEN=

# Demo operator login (HMAC token; not production SSO / RBAC).
# DEMO_OPERATOR_ACCOUNT=demo
# DEMO_OPERATOR_PASSWORD=demo123
# DEMO_OPERATOR_TENANT_ID=00000000-0000-0000-0000-000000000001
# AUTH_SECRET=

